{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalgardsdrinkar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalgardsdrinkar-db",
      "database_id": "06610f37-11c4-48e4-a3aa-5c9a74bed5d3"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dalgardsdrinkar-media"
    }
  ],

  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dalgardsdrinkar-db-dev",
          "database_id": "7ea48e8b-5eca-47e5-8fc8-18216978ac64",
          "remote": true
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "dalgardsdrinkar-media-dev",
          "remote": true
        }
      ]
    }
  }
}